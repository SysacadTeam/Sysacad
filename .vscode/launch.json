{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Sysacad.Server",
      "type": "coreclr",
      "request": "launch",
      "preLaunchTask": "build",
      "program": "${workspaceFolder}/Sysacad.Server/bin/Debug/net10.0/Sysacad.Server.dll",
      "args": [],
      "cwd": "${workspaceFolder}/Sysacad.Server",
      "env": {
        "ASPNETCORE_ENVIRONMENT": "Development",
        "ASPNETCORE_URLS": "http://localhost:5000",
        "SSL_CERT_DIR": "/home/vscode/.aspnet/dev-certs/trust:/usr/lib/ssl/certs"
      },
      "serverReadyAction": {
        "action": "openExternally",
        "pattern": "\\bNow listening on:\\s+(https?://\\S+)",
        "uriFormat": "%s"
      }
    },
    {
      "name": "Sysacad.Client",
      "type": "coreclr",
      "request": "launch",
      "preLaunchTask": "build",
      "program": "${workspaceFolder}/Sysacad.Client/bin/Debug/net10.0/Sysacad.Client.dll",
      "args": [],
      "cwd": "${workspaceFolder}/Sysacad.Client",
      "env": {
        "ASPNETCORE_ENVIRONMENT": "Development",
        "ASPNETCORE_URLS": "http://localhost:5156",
        "SSL_CERT_DIR": "/home/vscode/.aspnet/dev-certs/trust:/usr/lib/ssl/certs"
      },
      "serverReadyAction": {
        "action": "openExternally",
        "pattern": "\\bNow listening on:\\s+(https?://\\S+)",
        "uriFormat": "%s"
      }
    }
  ],
  "compounds": [
    {
      "name": "Sysacad (Client + Server)",
      "configurations": [
        "Sysacad.Server",
        "Sysacad.Client"
      ]
    }
  ]
}