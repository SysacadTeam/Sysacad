{
  "name": "Sysacad",
  "dockerComposeFile": "docker-compose.yml",
  "service": "app",
  "workspaceFolder": "/workspaces/Sysacad",
  "features": {
    "ghcr.io/devcontainers/features/common-utils:2": {
      "installZsh": true,
      "configureZshAsDefaultShell": true,
      "installOhMyZsh": true,
      "upgradePackages": true
    },
    "ghcr.io/devcontainers/features/git:1": {},
    "ghcr.io/devcontainers/features/github-cli:1": {},
    "ghcr.io/devcontainers/features/docker-in-docker:2": {}
  },
  "customizations": {
    "vscode": {
      "settings": {
        "dotnet.defaultSolution": "Sysacad.slnx",
        "editor.formatOnSave": true,
        "editor.bracketPairColorization.enabled": true,
        "omnisharp.enableRoslynAnalyzers": true
      },
      "extensions": [
        "ms-dotnettools.csharp",
        "ms-dotnettools.csdevkit",
        //"ms-dotnettools.dotnet-interactive-vscode",
        "ms-dotnettools.vscode-dotnet-runtime",
        "github.copilot",
        "github.copilot-chat",
        "eamodio.gitlens",
        "ms-azuretools.vscode-docker",
        "humao.rest-client",
        "EditorConfig.EditorConfig"
      ]
    }
  },
  "forwardPorts": [
    7083,
    7231,
    5000,
    5156
  ],
  "portsAttributes": {
    "7083": {
      "label": "Sysacad Server (HTTPS)"
    },
    "7231": {
      "label": "Sysacad Client (HTTPS)"
    },
    "5000": {
      "label": "Sysacad Server (HTTP)"
    },
    "5156": {
      "label": "Sysacad Client (HTTP)"
    }
  },
  "postCreateCommand": "sudo apt-get update && sudo apt-get install -y postgresql-client && sudo install -m 755 .devcontainer/bin/gcr /usr/local/bin/gcr && sudo install -m 755 .devcontainer/bin/dev /usr/local/bin/dev && dotnet restore Sysacad.slnx && dotnet tool restore || true && dotnet tool install --global dotnet-ef --version 10.0.5 && echo 'export PATH=\"$PATH:$HOME/.dotnet/tools\"' >> ~/.zshrc && echo 'export PATH=\"$PATH:$HOME/.dotnet/tools\"' >> ~/.bashrc",
  "postStartCommand": "sudo chown -R vscode:vscode . 2>/dev/null || true && dev start",
  "remoteEnv": {
    "PATH": "${containerEnv:PATH}:/home/vscode/.dotnet/tools",
    "SSL_CERT_DIR": "/home/vscode/.aspnet/dev-certs/trust:/usr/lib/ssl/certs",
    "ASPNETCORE_ENVIRONMENT": "Development",
    "DB_HOST": "db",
    "DB_PORT": "5432",
    "DB_NAME": "sysacad",
    "DB_USER": "postgres",
    "DB_PASS": "sysacad"
  },
  "remoteUser": "vscode"
}