#!/usr/bin/env bash
# dev — Development helper CLI for Sysacad
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
WORKSPACE_DIR="$(cd "${SCRIPT_DIR}/../.." && pwd)"

DB_HOST="${DB_HOST:-db}"
DB_PORT="${DB_PORT:-5432}"
DB_NAME="${DB_NAME:-sysacad}"
DB_USER="${DB_USER:-postgres}"
DB_PASS="${DB_PASS:-sysacad}"
CERTS_DIR="${WORKSPACE_DIR}/.devcontainer/certs"
PROJECT_DIR="${WORKSPACE_DIR}/Sysacad.Server"
DUMP_DIR="${WORKSPACE_DIR}/.devcontainer/dumps"

wait_for_db() {
    local max_retries=30
    local interval=2
    echo "⏳ Waiting for PostgreSQL at ${DB_HOST}:${DB_PORT}..."
    for i in $(seq 1 $max_retries); do
        if pg_isready -h "$DB_HOST" -p "$DB_PORT" -q 2>/dev/null || \
           (echo > /dev/tcp/"$DB_HOST"/"$DB_PORT") 2>/dev/null; then
            echo "✅ PostgreSQL is ready!"
            return 0
        fi
        if [ "$i" -eq "$max_retries" ]; then
            echo "❌ PostgreSQL did not become ready after $((max_retries * interval))s"
            return 1
        fi
        sleep $interval
    done
}

cmd_start() {
    wait_for_db

    if [ -d "$PROJECT_DIR/Migrations" ] && [ "$(ls -A "$PROJECT_DIR/Migrations" 2>/dev/null)" ]; then
        echo "🔄 Applying EF Core migrations..."
    dotnet ef database update --project "$PROJECT_DIR" --no-build 2>/dev/null || \
        dotnet ef database update --project "$PROJECT_DIR"
        echo "✅ Migrations applied successfully!"
    else
        echo "ℹ️  No migrations found, skipping."
    fi
}

cmd_dump() {
    local prod_env="${WORKSPACE_DIR}/.dev/prod.env"
    if [[ -f "$prod_env" ]]; then
        # shellcheck source=/dev/null
        source "$prod_env"
    fi

    local ssl_ca="${SSL_CA:-}"
    local ssl_crt="${SSL_CRT:-}"
    local ssl_key="${SSL_KEY:-}"

    # Validate cert files
    for f in "$ssl_ca" "$ssl_crt" "$ssl_key"; do
        if [[ -z "$f" ]]; then
            echo "❌ SSL paths not configured. Set SSL_CA, SSL_CRT and SSL_KEY in .dev/prod.env"
            return 1
        fi
        if [[ ! -f "$f" ]]; then
            echo "❌ File not found: $f"
            echo "   Copy it to '${CERTS_DIR}' on your host machine first."
            return 1
        fi
    done

    # Copy to /tmp and fix permissions (files from Windows mount may be owned by root)
    local tmp_ca=/tmp/ssl_ca.pem tmp_crt=/tmp/ssl_client.crt tmp_key=/tmp/ssl_client.key
    cp "$ssl_ca" "$tmp_ca" && cp "$ssl_crt" "$tmp_crt" && cp "$ssl_key" "$tmp_key"
    chmod 600 "$tmp_key"

    wait_for_db

    echo "🗑️  Dropeando DB local '${DB_NAME}'..."
    PGPASSWORD="${DB_PASS}" psql -h "${DB_HOST}" -p "${DB_PORT}" -U "${DB_USER}" postgres \
        -c "SELECT pg_terminate_backend(pid) FROM pg_stat_activity WHERE datname = '${DB_NAME}' AND pid <> pg_backend_pid();" \
        -c "DROP DATABASE IF EXISTS \"${DB_NAME}\";" \
        -c "CREATE DATABASE \"${DB_NAME}\";"

    echo "📦 Dumping production '${PROD_DB}' y restaurando en local '${DB_NAME}'..."
    (
        export PGSSLMODE=verify-full
        export PGSSLROOTCERT="$tmp_ca"
        export PGSSLCERT="$tmp_crt"
        export PGSSLKEY="$tmp_key"
        PGPASSWORD="${PROD_PASS}" pg_dump \
            -h "${PROD_HOST}" -p "${PROD_PORT}" -U "${PROD_USER}" \
            -Fc --no-owner --no-acl "${PROD_DB}"
    ) | PGPASSWORD="${DB_PASS}" pg_restore \
        -h "${DB_HOST}" -p "${DB_PORT}" -U "${DB_USER}" \
        --no-owner --no-acl -d "${DB_NAME}"
    echo "✅ DB local actualizada con datos de producción."
}

cmd_restart() {
    echo "🔄 Restarting PostgreSQL container (db)..."
    docker restart db
    wait_for_db
    echo "✅ PostgreSQL restarted!"
}

usage() {
    cat <<EOF
dev — Sysacad development helper

Usage: dev <command>

Commands:
  start     Wait for PostgreSQL and apply EF Core migrations
  dump      Dump the database to .devcontainer/dumps/
  restart   Restart the PostgreSQL container
EOF
}

case "${1:-}" in
    start)   cmd_start   ;;
    dump)    cmd_dump     ;;
    restart) cmd_restart  ;;
    *)       usage; exit 1 ;;
esac
